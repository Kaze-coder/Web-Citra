# Database Configuration (MySQL - Laragon/phpMyAdmin lokal)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=isp_management
DB_PORT=3306

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS: origin frontend yang diizinkan (pisahkan dengan koma)
FRONTEND_ORIGIN=http://localhost:5000,http://127.0.0.1:5000

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# WhatsApp API Configuration (Fonnte)
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_KEY=your_fonnte_api_key_here

# Google Maps API (opsional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Earth Engine Configuration
GEE_PROJECT_ID=your-gcloud-project-id
GEE_SERVICE_ACCOUNT_KEY=./config/gee-service-account.json
